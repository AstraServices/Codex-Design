{
  "name": "Bamboo Stalk",
  "description": "Cartoon simulator bamboo · 4 segments with node rings · skinned · Sway & Hit",
  "module": "bamboo-stalk.js",
  "parameters": { "color": "#8cc63f", "cutColor": "#d4ec8c", "nodeColor": "#3f7a1a", "height": 3.2, "radius": 0.34 },
  "controls": {
    "color": { "label": "Stalk green", "type": "color" },
    "cutColor": { "label": "Cut face", "type": "color" },
    "nodeColor": { "label": "Node rings", "type": "color" },
    "height": { "label": "Height", "type": "number", "min": 1.5, "max": 6, "step": 0.1 },
    "radius": { "label": "Radius", "type": "number", "min": 0.15, "max": 0.6, "step": 0.01 }
  }
}
