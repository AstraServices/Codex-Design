{
  "name": "STUD PINE / stud + gradient bake",
  "description": "GradientTrain style · StudTrain studs on every face · rim + vignette + voxel AO baked · model gradient · no highlight",
  "module": "stud-pine.js",
  "lighting": "roblox",
  "parameters": {
    "leaves": "#2a8e28",
    "bark": "#6a3020",
    "tiers": 4,
    "width": 8,
    "gradientBottom": 0.5,
    "gradientTop": 1.15
  },
  "controls": {
    "leaves": {
      "label": "Leaves",
      "type": "color"
    },
    "bark": {
      "label": "Bark",
      "type": "color"
    },
    "tiers": {
      "label": "Canopy tiers",
      "type": "number",
      "min": 2,
      "max": 6,
      "step": 1
    },
    "width": {
      "label": "Canopy width (studs)",
      "type": "number",
      "min": 4,
      "max": 12,
      "step": 2
    },
    "gradientBottom": {
      "label": "Gradient bottom",
      "type": "number",
      "min": 0.3,
      "max": 1,
      "step": 0.02
    },
    "gradientTop": {
      "label": "Gradient top",
      "type": "number",
      "min": 0.9,
      "max": 1.4,
      "step": 0.02
    }
  },
  "gfx": {
    "preset": "card",
    "title": "Pine Tree",
    "tag": "NATURE",
    "footer": "Codex Design · Stud Nature"
  }
}
