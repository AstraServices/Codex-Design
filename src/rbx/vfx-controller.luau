--!nonstrict
-- VFXStudio runtime (generated by Codex Design VFX Studio). Put the CodexVFX folder in ReplicatedStorage.
--   local VFX = require(ReplicatedStorage.CodexVFX.VFXStudio)
--   local h = VFX.Play("IceExplosion", { Position = Vector3.new(0, 5, 0), Scale = 1.5, Quality = "Auto" })
--   VFX.Pause(h) VFX.Resume(h) VFX.SetSpeed(h, 0.5) VFX.SetScale(h, 2) VFX.SetColor(h, Color3.new(1,0,0)) VFX.Stop(h)
-- Server: VFX.PlayForAll(name, opts) / VFX.PlayFor(player, name, opts) fire a RemoteEvent; clients play locally.
-- Effects are templates under script.Effects. Each has a "Root" part (attachments, emitters, beams, trails, lights),
-- optional mesh parts and a "Timeline" StringValue (JSON events) that this module schedules with its own clock,
-- so Pause/Resume/SetSpeed are exact (particles follow through ParticleEmitter.TimeScale, which Roblox caps at 1).
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local HttpService = game:GetService("HttpService")
local Players = game:GetService("Players")
local Lighting = game:GetService("Lighting")
local CollectionService = game:GetService("CollectionService")
local ContentProvider = game:GetService("ContentProvider")
local UserInputService = game:GetService("UserInputService")

local VFX = {}
VFX.CullDistance = 250
VFX.PoolSize = 4
VFX.Version = "1.0"

local EffectsFolder = script:WaitForChild("Effects")
local REMOTE_NAME = "CodexVFXEvent"
local pools: { [string]: { Instance } } = {}
local timelines: { [string]: any } = {}
local active: { [any]: boolean } = {}

type Handle = {
	Name: string, Model: Instance, Root: BasePart, Events: { any }, Index: number, Clock: number, Speed: number,
	Paused: boolean, Scale: number, Duration: number, Loop: boolean, Anims: { any }, Follow: Instance?, Offset: CFrame,
	Quality: number, Done: boolean, Conn: RBXScriptConnection?, Base: { [Instance]: any },
}

local function timelineOf(name: string)
	if timelines[name] == nil then
		local template = EffectsFolder:FindFirstChild(name)
		assert(template, ("VFXStudio: no effect named %q"):format(name))
		local value = template:FindFirstChild("Timeline") :: StringValue?
		timelines[name] = if value then HttpService:JSONDecode(value.Value) else { duration = 1, events = {} }
	end
	return timelines[name]
end

local function qualityFactor(q: any): number
	if typeof(q) == "number" then return math.clamp(q, 0.1, 1) end
	if q == "Low" then return 0.35 elseif q == "Medium" then return 0.65 elseif q == "High" then return 1 end
	-- Auto: graphics level on clients, halved on touch-only devices
	local f = 1
	if RunService:IsClient() then
		local ok, level = pcall(function() return UserSettings().GameSettings.SavedQualityLevel.Value end)
		if ok and level and level > 0 then f = math.clamp(level / 10, 0.3, 1) end
		if UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled then f *= 0.6 end
	end
	return f
end

local function find(model: Instance, path: string): Instance?
	local node: Instance? = model
	for part in string.gmatch(path, "[^/]+") do
		node = node and node:FindFirstChild(part)
	end
	return node
end

local function toValue(v: any, kind: string?): any
	if kind == "vector3" then return Vector3.new(v[1], v[2], v[3]) end
	if kind == "color3" then return Color3.new(v[1], v[2], v[3]) end
	return v
end

local function lerp(a: any, b: any, t: number): any
	if typeof(a) == "number" then return a + (b - a) * t end
	if typeof(a) == "Vector3" then return a:Lerp(b, t) end
	if typeof(a) == "Color3" then return a:Lerp(b, t) end
	return if t >= 1 then b else a
end

local function scaleSequence(seq: NumberSequence, k: number): NumberSequence
	local points = {}
	for _, p in seq.Keypoints do table.insert(points, NumberSequenceKeypoint.new(p.Time, p.Value * k, p.Envelope * k)) end
	return NumberSequence.new(points)
end

-- Scales every size-like property relative to the template values (so SetScale can be called repeatedly).
local function applyScale(h: Handle, k: number)
	for inst, base in h.Base do
		if inst:IsA("ParticleEmitter") then
			inst.Size = scaleSequence(base.Size, k)
			inst.Speed = NumberRange.new(base.Speed.Min * k, base.Speed.Max * k)
			inst.Acceleration = base.Acceleration * k
		elseif inst:IsA("Beam") then
			inst.Width0 = base.Width0 * k; inst.Width1 = base.Width1 * k
			inst.CurveSize0 = base.CurveSize0 * k; inst.CurveSize1 = base.CurveSize1 * k
		elseif inst:IsA("Trail") then
			inst.WidthScale = scaleSequence(base.WidthScale, 1)
		elseif inst:IsA("Attachment") then
			inst.Position = base.Position * k
		elseif inst:IsA("PointLight") or inst:IsA("SpotLight") or inst:IsA("SurfaceLight") then
			inst.Range = math.min(60, base.Range * k)
		elseif inst:IsA("BasePart") and inst ~= h.Root then
			inst.Size = base.Size * k
		end
	end
	h.Scale = k
end

local function recolor(h: Handle, color: Color3)
	local function tint(seq: ColorSequence): ColorSequence
		local points = {}
		for _, p in seq.Keypoints do
			local l = math.max(p.Value.R, p.Value.G, p.Value.B)
			table.insert(points, ColorSequenceKeypoint.new(p.Time, Color3.new(color.R * l, color.G * l, color.B * l)))
		end
		return ColorSequence.new(points)
	end
	for inst, base in h.Base do
		if inst:IsA("ParticleEmitter") or inst:IsA("Beam") or inst:IsA("Trail") then
			(inst :: any).Color = tint(base.Color)
		elseif inst:IsA("Light") then
			(inst :: any).Color = color
		elseif inst:IsA("BasePart") and inst ~= h.Root then
			(inst :: any).Color = color
		end
	end
end

local function snapshot(model: Instance): { [Instance]: any }
	local base = {}
	for _, d in model:GetDescendants() do
		if d:IsA("ParticleEmitter") then base[d] = { Size = d.Size, Speed = d.Speed, Acceleration = d.Acceleration, Color = d.Color, Rate = d.Rate, Enabled = d.Enabled }
		elseif d:IsA("Beam") then base[d] = { Width0 = d.Width0, Width1 = d.Width1, CurveSize0 = d.CurveSize0, CurveSize1 = d.CurveSize1, Color = d.Color, Enabled = d.Enabled }
		elseif d:IsA("Trail") then base[d] = { WidthScale = d.WidthScale, Color = d.Color, Enabled = d.Enabled }
		elseif d:IsA("Attachment") then base[d] = { Position = d.Position }
		elseif d:IsA("PointLight") or d:IsA("SpotLight") or d:IsA("SurfaceLight") then base[d] = { Range = d.Range, Brightness = d.Brightness, Enabled = d.Enabled }
		elseif d:IsA("BasePart") then base[d] = { Size = d.Size, Transparency = d.Transparency, CFrame = d.CFrame }
		elseif d:IsA("PostEffect") or d:IsA("Highlight") then base[d] = { Enabled = (d :: any).Enabled }
		end
	end
	return base
end

local function acquire(name: string): Instance
	local pool = pools[name]
	if pool and #pool > 0 then return table.remove(pool) :: Instance end
	local template = EffectsFolder:FindFirstChild(name)
	assert(template, ("VFXStudio: no effect named %q"):format(name))
	return template:Clone()
end

local function release(h: Handle)
	if h.Conn then h.Conn:Disconnect(); h.Conn = nil end
	active[h] = nil
	for inst, base in h.Base do
		if inst:IsA("ParticleEmitter") then inst.Enabled = false; inst.TimeScale = 1; inst:Clear() end
		if inst:IsA("Beam") or inst:IsA("Trail") or inst:IsA("Light") or inst:IsA("PostEffect") or inst:IsA("Highlight") then (inst :: any).Enabled = false end
		if inst:IsA("PostEffect") then inst.Parent = h.Model end
	end
	local pool = pools[h.Name] or {}
	pools[h.Name] = pool
	if #pool < VFX.PoolSize then
		applyScale(h, 1)
		h.Model.Parent = nil
		table.insert(pool, h.Model)
	else
		h.Model:Destroy()
	end
end

local function place(h: Handle)
	if h.Follow then
		local f = h.Follow :: any
		local cf = if f:IsA("Attachment") then f.WorldCFrame elseif f:IsA("BasePart") then f.CFrame elseif f:IsA("Model") and f.PrimaryPart then f.PrimaryPart.CFrame else nil
		if cf then h.Root.CFrame = cf * h.Offset else h.Follow = nil end
	end
	for _, d in h.Model:GetChildren() do
		if d:IsA("BasePart") and d ~= h.Root then
			local ov = d:FindFirstChild("CodexOffset") :: CFrameValue?
			local rel = if ov then ov.Value else CFrame.new()
			d.CFrame = h.Root.CFrame * CFrame.new(rel.Position * h.Scale) * (rel - rel.Position)
		end
	end
end

local function run(h: Handle, e: any)
	local target = find(h.Model, e.target)
	if not target then return end
	if e.kind == "emit" then
		local emitter = target :: ParticleEmitter
		emitter:Emit(math.max(1, math.floor(e.count * h.Quality + 0.5)))
	elseif e.kind == "enable" then
		if target:IsA("ParticleEmitter") and e.on and h.Base[target] then target.Rate = h.Base[target].Rate * h.Quality end
		if target:IsA("PostEffect") then target.Parent = if e.on then Lighting else h.Model end
		local switch = target :: any
		switch.Enabled = e.on
	elseif e.kind == "anim" then
		table.insert(h.Anims, { inst = target, prop = e.prop, from = toValue(e.from, e.type), to = toValue(e.to, e.type), t0 = e.t, dur = math.max(e.dur, 1e-3),
			style = Enum.EasingStyle[e.style or "Quad"], dir = Enum.EasingDirection[e.dir or "Out"], scaled = e.prop == "Size" })
	end
end

local function step(h: Handle, dt: number)
	if h.Paused or h.Done then return end
	h.Clock += dt * h.Speed
	while h.Index <= #h.Events and h.Events[h.Index].t <= h.Clock do
		run(h, h.Events[h.Index]); h.Index += 1
	end
	for i = #h.Anims, 1, -1 do
		local a = h.Anims[i]
		local alpha = math.clamp((h.Clock - a.t0) / a.dur, 0, 1)
		local v = lerp(a.from, a.to, TweenService:GetValue(alpha, a.style, a.dir))
		if a.scaled and typeof(v) == "Vector3" then v *= h.Scale end
		if a.prop == "Range" then v *= h.Scale end
		pcall(function() a.inst[a.prop] = v end)
		if alpha >= 1 then table.remove(h.Anims, i) end
	end
	place(h)
	if h.Clock >= h.Duration then
		if h.Loop then
			h.Clock = 0; h.Index = 1; table.clear(h.Anims)
		else
			h.Done = true
			task.delay(0, release, h)
		end
	end
end

--- Play an effect. opts: Position, CFrame, Parent (BasePart | Attachment | Bone | Model: follows it), Offset (CFrame),
--- Scale, Speed, Color (Color3), Quality ("Auto" | "Low" | "Medium" | "High" | 0–1), Loop, Duration.
function VFX.Play(name: string, opts: { [string]: any }?): Handle?
	local o = opts or {}
	-- Distance culling (clients): skip effects far from the camera.
	if RunService:IsClient() and not o.Parent then
		local cam = workspace.CurrentCamera
		local pos = o.Position or (o.CFrame and o.CFrame.Position)
		if cam and pos and (cam.CFrame.Position - pos).Magnitude > (o.CullDistance or VFX.CullDistance) then return nil end
	end
	local tl = timelineOf(name)
	local model = acquire(name)
	local root = model:FindFirstChild("Root") :: BasePart
	local h: Handle = {
		Name = name, Model = model, Root = root, Events = tl.events, Index = 1, Clock = 0, Speed = o.Speed or 1, Paused = false,
		Scale = 1, Duration = o.Duration or tl.duration, Loop = if o.Loop ~= nil then o.Loop else tl.loop == true, Anims = {},
		Follow = o.Parent, Offset = o.Offset or CFrame.new(), Quality = qualityFactor(o.Quality or "Auto"), Done = false, Base = snapshot(model),
	}
	root.CFrame = o.CFrame or CFrame.new(o.Position or Vector3.zero)
	applyScale(h, o.Scale or 1)
	if o.Color then recolor(h, o.Color) end
	for inst in h.Base do if inst:IsA("ParticleEmitter") then inst.TimeScale = math.clamp(h.Speed, 0, 1) end end
	model.Parent = workspace:FindFirstChild("CodexVFX") or (function()
		local f = Instance.new("Folder"); f.Name = "CodexVFX"; f.Parent = workspace; return f
	end)()
	CollectionService:AddTag(model, "CodexVFX")
	place(h)
	active[h] = true
	h.Conn = RunService.Heartbeat:Connect(function(dt) step(h, dt) end)
	step(h, 0)
	return h
end

function VFX.Stop(h: Handle?)
	if h and not h.Done then
		h.Done = true
		-- let live particles fade instead of popping
		for inst in h.Base do if inst:IsA("ParticleEmitter") then inst.Enabled = false end end
		task.delay(1, release, h)
	end
end
function VFX.Destroy(h: Handle?)
	if h then h.Done = true; if h.Conn then h.Conn:Disconnect() end; active[h] = nil; h.Model:Destroy() end
end
function VFX.Pause(h: Handle?)
	if h and not h.Paused then h.Paused = true; for inst in h.Base do if inst:IsA("ParticleEmitter") then inst.TimeScale = 0 end end end
end
function VFX.Resume(h: Handle?)
	if h and h.Paused then h.Paused = false; for inst in h.Base do if inst:IsA("ParticleEmitter") then inst.TimeScale = math.clamp(h.Speed, 0, 1) end end end
end
function VFX.SetSpeed(h: Handle?, speed: number)
	if h then h.Speed = math.max(0, speed); if not h.Paused then for inst in h.Base do if inst:IsA("ParticleEmitter") then inst.TimeScale = math.clamp(h.Speed, 0, 1) end end end end
end
function VFX.SetScale(h: Handle?, scale: number) if h then applyScale(h, scale); place(h) end end
function VFX.SetColor(h: Handle?, color: Color3) if h then recolor(h, color) end end
function VFX.StopAll() for h in active do VFX.Stop(h) end end
function VFX.List(): { string } local out = {}; for _, e in EffectsFolder:GetChildren() do table.insert(out, e.Name) end; return out end

--- Preload textures (and warm the pool) so the first play has no pop-in.
function VFX.Preload(names: { string }?)
	local list = {}
	for _, e in EffectsFolder:GetChildren() do
		if not names or table.find(names, e.Name) then
			table.insert(list, e)
			pools[e.Name] = pools[e.Name] or {}
			if #pools[e.Name] == 0 then table.insert(pools[e.Name], e:Clone()) end
		end
	end
	if RunService:IsClient() then ContentProvider:PreloadAsync(list) end
end

-- Server → client playback
local function remote(): RemoteEvent
	local r = script:FindFirstChild(REMOTE_NAME) :: RemoteEvent?
	if r then return r end
	assert(RunService:IsServer(), "VFXStudio: RemoteEvent missing; require the module on the server first")
	local made = Instance.new("RemoteEvent"); made.Name = REMOTE_NAME; made.Parent = script
	return made
end
function VFX.PlayForAll(name: string, opts: { [string]: any }?) remote():FireAllClients(name, opts) end
function VFX.PlayFor(player: Player, name: string, opts: { [string]: any }?) remote():FireClient(player, name, opts) end
function VFX.PlayNear(position: Vector3, radius: number, name: string, opts: { [string]: any }?)
	for _, p in Players:GetPlayers() do
		local c = p.Character
		local hrp = c and c:FindFirstChild("HumanoidRootPart") :: BasePart?
		if hrp and (hrp.Position - position).Magnitude <= radius then remote():FireClient(p, name, opts) end
	end
end

if RunService:IsServer() then
	remote()
else
	task.spawn(function()
		local r = script:WaitForChild(REMOTE_NAME, 30) :: RemoteEvent?
		if r then r.OnClientEvent:Connect(function(name, opts) VFX.Play(name, opts) end) end
	end)
end

return VFX
